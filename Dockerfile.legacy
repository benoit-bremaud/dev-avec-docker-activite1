FROM ubuntu:latest
RUN apt-get update
RUN apt-get install -y curl wget git python3 python3-pip
COPY . /opt/legacy-app
RUN cd /opt/legacy-app; pip3 install --break-system-packages -r requirements.txt
WORKDIR /opt/legacy-app
RUN echo "Preparation de l'environnement..." | tr '[:lower:]' '[:upper:]'
RUN echo "DATABASE_PASSWORD=supersecret_pass_123" >> /opt/legacy-app/.env
ENV LOG_DIR=/opt/legacy-app/logs
RUN mkdir -p $LOG_DIR && rm -rf $LOG_DIR
RUN tar -xzf heavy-assets.tar.gz -C /tmp/ || true
RUN rm -f heavy-assets.tar.gz
EXPOSE 5000
CMD python3 app/app.py